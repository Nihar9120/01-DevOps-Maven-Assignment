pipeline{
    agent any
    environment {
        PATH = "$PATH:/opt/apache-maven-3.9.11/bin"
    }
    stages{
        stage ('GetCode'){
            steps{
                git branch: 'main',
                url: "https://github.com/Nihar9120/01-DevOps-Maven-Assignment.git"
            }
        }
        stage('Build'){
            steps{
                sh 'mvn clean package'
            }
        }
        stage('SonarQube analysis'){
            steps{
                withSonarQubeEnv('Sonar-Server-9.9.4'){
                    sh 'mvn sonar:sonar'
                }
            }
        }
        stage('Deploy to Tomcat') {
    steps {
        sh '''
            scp -o StrictHostKeyChecking=no target/01-maven-webapp.war ec2-user@3.7.71.179:/home/ec2-user/apache-tomcat-9.0.111/webapps/
        '''
    }
}

    }
}
