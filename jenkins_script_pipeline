pipeline{
    agent any
    environment {
        PATH = "$PATH:/opt/apache-maven-3.9.11/bin"
    }
    stages{
        stage ('GetCode'){
            steps{
                git branch: 'main',
                url: "https://github.com/Nihar9120/01-DevOps-Maven-Assignment.git"
            }
        }
        stage('Build'){
            steps{
                sh 'mvn clean package'
            }
        }
    }
}